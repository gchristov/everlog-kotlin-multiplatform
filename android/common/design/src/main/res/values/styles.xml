<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Buttons -->
    <style name="Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:background">@drawable/rounded_corners_btn_one</item>
        <item name="android:textColor">@color/background_card</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingLeft">@dimen/activity_margin_double</item>
        <item name="android:paddingTop">@dimen/activity_margin_half</item>
        <item name="android:paddingRight">@dimen/activity_margin_double</item>
        <item name="android:paddingBottom">@dimen/activity_margin_half</item>
    </style>
    <style name="Button.Four" parent="Button.Three">
        <item name="android:background">@null</item>
    </style>
    <style name="Button.Three" parent="Button.Two">
        <item name="android:background">@drawable/rounded_corners_btn_three</item>
    </style>
    <style name="Button.Two" parent="Button">
        <item name="android:background">@drawable/rounded_corners_btn_two</item>
        <item name="android:textColor">@color/main_accent</item>
    </style>
    <!-- Dialog styling -->
    <style name="CustomBottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
    </style>
    <style name="CustomBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="behavior_peekHeight">250dp</item>
    </style>
    <style name="DarkDialogTheme" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:background">@color/background_card</item>
        <item name="android:textColor">@color/white_base</item>
        <item name="android:textColorPrimary">@color/gray_5</item>
        <!-- The buttons as in the Compose AppDialog: positive is the primary action, negative the
        secondary one and neutral any other -->
        <item name="android:buttonBarStyle">@style/DialogButtonBar</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/DialogButton.Primary</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/DialogButton.Secondary</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/DialogButton.Tertiary</item>
    </style>
    <style name="DarkDialogTheme.RadioGroup" parent="DarkDialogTheme">
        <item name="android:textColorAlertDialogListItem">@color/gray_5</item>
        <item name="android:textColorSecondary">@color/gray_5</item>
    </style>
    <!-- The app's buttons with less padding than a full-width one, so up to three fit on a row, and shorter
    (no 48dp minimum, so about 36dp). Where they still don't fit, Android stacks them. Keep labels short:
    Android first measures a dialog at about 320dp wide, and if the buttons stack there, the dialog keeps
    that taller height even after they fit on one row at its real width. -->
    <style name="DialogButton.Primary" parent="Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/activity_margin_half</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingLeft">@dimen/margin_12</item>
        <item name="android:paddingRight">@dimen/margin_12</item>
    </style>
    <style name="DialogButton.Secondary" parent="Button.Three">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/activity_margin_half</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingLeft">@dimen/margin_12</item>
        <item name="android:paddingRight">@dimen/margin_12</item>
    </style>
    <style name="DialogButton.Tertiary" parent="Button.Four">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingLeft">@dimen/activity_margin_half</item>
        <item name="android:paddingRight">@dimen/activity_margin_half</item>
    </style>
    <!-- Around the buttons. Android's button bar pads them 12dp at the sides and 4dp above and below,
    so with this they line up with the title's 24dp margin and sit 24dp from the bottom, as in Compose. -->
    <style name="DialogButtonBar" parent="@android:style/Widget.Material.ButtonBar.AlertDialog">
        <item name="android:paddingStart">@dimen/margin_12</item>
        <item name="android:paddingEnd">@dimen/margin_12</item>
        <item name="android:paddingTop">@dimen/activity_margin_half</item>
        <item name="android:paddingBottom">@dimen/margin_20</item>
    </style>
    <style name="AppPopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/rounded_corners_popup_menu</item>
        <item name="android:popupElevation">8dp</item>
        <!-- Opens below its button, 4dp clear of it -->
        <item name="overlapAnchor">false</item>
        <item name="android:overlapAnchor">false</item>
        <item name="android:dropDownVerticalOffset">4dp</item>
    </style>
    <style name="AppPopupMenu.Overflow" parent="Widget.AppCompat.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/rounded_corners_popup_menu</item>
        <item name="android:popupElevation">8dp</item>
        <item name="overlapAnchor">false</item>
        <item name="android:overlapAnchor">false</item>
        <item name="android:dropDownVerticalOffset">4dp</item>
    </style>
    <style name="AppPopupMenuText" parent="TextAppearance.AppCompat.Widget.PopupMenu.Large">
        <item name="android:textColor">@color/white_darker</item>
        <item name="android:textSize">16sp</item>
    </style>
    <!-- Spinners: their options open like a popup menu, with the current choice ticked
         (view_spinner_row_dropdown) -->
    <style name="AppSpinner" parent="Widget.AppCompat.Spinner">
        <item name="popupTheme">@style/AppTheme.PopupOverlay</item>
        <item name="android:popupBackground">@drawable/rounded_corners_popup_menu</item>
        <item name="android:popupElevation">8dp</item>
        <item name="overlapAnchor">false</item>
        <item name="android:overlapAnchor">false</item>
        <item name="android:dropDownVerticalOffset">4dp</item>
    </style>
    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar"/>
    <!-- Popup menus, from the toolbars' overflow and rows' ⋮ buttons (ui/views/PopupMenus.kt). The
         XML twin of the design system's AppMenu (AppOverflowMenu.kt): change both together. -->
    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Dark">
        <item name="popupMenuStyle">@style/AppPopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/AppPopupMenu.Overflow</item>
        <item name="textAppearanceLargePopupMenu">@style/AppPopupMenuText</item>
        <item name="textAppearanceSmallPopupMenu">@style/AppPopupMenuText</item>
        <item name="android:textColorPrimary">@color/white_darker</item>
        <item name="colorControlHighlight">@color/separator</item>
        <!-- Rows like AppListItem's: 56dp high, 16dp in from the sides (AppCompat's own, with icons
             placed by abc_list_menu_item_icon) -->
        <item name="dropdownListPreferredItemHeight">56dp</item>
    </style>
    <!-- Spinner styling -->
    <style name="SpinnerItemStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/white_base</item>
        <item name="android:textSize">@dimen/dropdown_text_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingLeft">@dimen/activity_margin_half</item>
        <item name="android:paddingRight">@dimen/activity_margin_half</item>
    </style>
    <!-- Settings -->
    <style name="SettingsCategory">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/gray_1</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="Toolbar.HomeSubtitle" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/white_darker</item>
    </style>
    <style name="Toolbar.HomeSubtitle.Collapsed">
        <item name="android:shadowColor">#000</item>
        <item name="android:shadowDx">@integer/cover_text_shadow_d</item>
        <item name="android:shadowDy">@integer/cover_text_shadow_d</item>
        <item name="android:shadowRadius">@integer/cover_text_shadow_radius</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="Toolbar.HomeSubtitle.Expanded">
        <item name="android:shadowColor">#000</item>
        <item name="android:shadowDx">@integer/cover_text_shadow_d</item>
        <item name="android:shadowDy">@integer/cover_text_shadow_d</item>
        <item name="android:shadowRadius">@integer/cover_text_shadow_radius</item>
    </style>
    <!-- Toolbars -->
    <style name="Toolbar.HomeTitle" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">30sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/white_base</item>
    </style>
    <style name="Toolbar.HomeTitle.Collapsed" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:shadowColor">#000</item>
        <item name="android:shadowDx">@integer/cover_text_shadow_d</item>
        <item name="android:shadowDy">@integer/cover_text_shadow_d</item>
        <item name="android:shadowRadius">@integer/cover_text_shadow_radius</item>
    </style>
    <style name="Toolbar.HomeTitle.Expanded">
        <item name="android:shadowColor">#000</item>
        <item name="android:shadowDx">@integer/cover_text_shadow_d</item>
        <item name="android:shadowDy">@integer/cover_text_shadow_d</item>
        <item name="android:shadowRadius">@integer/cover_text_shadow_radius</item>
    </style>
    <style name="SettingsTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/white_darker</item>
        <item name="android:textSize">@dimen/settings_row_text_size</item>
    </style>
    <style name="SettingsValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/main_accent</item>
        <item name="android:textSize">@dimen/settings_row_text_size</item>
        <item name="android:layout_marginRight">@dimen/activity_margin_half_half_half</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
