<?xml version="1.0" encoding="utf-8"?>
<!-- A tab as the design system's AppChip. The gap to the next tab is padding: TabLayout leaves out a margin when it sizes the tab -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingEnd="@dimen/activity_margin_half">

    <TextView
        android:id="@android:id/text1"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/chip_height"
        android:background="@drawable/chip_background"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="1"
        android:paddingStart="@dimen/activity_margin"
        android:paddingEnd="@dimen/activity_margin"
        android:textColor="@color/chip_text"
        android:textSize="14sp"
        tools:text="Title" />
</FrameLayout>
