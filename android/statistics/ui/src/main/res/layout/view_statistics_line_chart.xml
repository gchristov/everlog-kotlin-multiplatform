<?xml version="1.0" encoding="utf-8"?>
<!-- A statistics line chart with what each axis measures up its side, for Compose to show (StatisticsLineChart). The right
     axis's label shows only when a line is measured on it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="horizontal">

    <com.github.rongi.rotate_layout.layout.RotateLayout
        android:id="@+id/axisTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/margin_12"
        app:angle="90">

        <TextView
            android:id="@+id/axisTitleLbl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:textAllCaps="true"
            android:textColor="@color/gray_2"
            android:textSize="@dimen/statistics_vertical_text_size" />
    </com.github.rongi.rotate_layout.layout.RotateLayout>

    <com.github.mikephil.charting.charts.LineChart
        android:id="@+id/chart"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/margin_10"
        android:layout_marginTop="@dimen/activity_margin"
        android:layout_marginRight="@dimen/margin_10"
        android:layout_marginBottom="@dimen/activity_margin"
        android:layout_weight="1" />

    <com.github.rongi.rotate_layout.layout.RotateLayout
        android:id="@+id/axisRightTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/margin_12"
        android:visibility="gone"
        app:angle="90">

        <TextView
            android:id="@+id/axisRightTitleLbl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:textAllCaps="true"
            android:textColor="@color/gray_2"
            android:textSize="@dimen/statistics_vertical_text_size" />
    </com.github.rongi.rotate_layout.layout.RotateLayout>
</LinearLayout>
