<?xml version="1.0" encoding="utf-8"?>
<!-- Replaces AppCompat's layout of the same name, so popup menus' icons sit like AppMenu's
     (common:compose elements/AppOverflowMenu.kt): 16dp from the card's edge and 16dp before the label,
     which AppCompat's title already keeps. AppCompat's has 8dp and -8dp. -->
<ImageView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/icon"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center_vertical"
    android:layout_marginStart="16dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    android:duplicateParentState="true"
    android:scaleType="centerInside" />
