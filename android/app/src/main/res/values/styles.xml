<resources>

    <!-- Base application theme -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here -->
        <item name="colorPrimary">@color/background_toolbar</item>
        <item name="colorPrimaryDark">@color/background_base</item>
        <item name="colorAccent">@color/main_accent</item>
    </style>
    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background_base</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>

    <style name="AppTheme.Transparent" parent="AppTheme.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <style name="UCropTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="CoverText">
        <item name="android:shadowColor">#000</item>
        <item name="android:shadowDx">@integer/cover_text_shadow_d</item>
        <item name="android:shadowDy">@integer/cover_text_shadow_d</item>
        <item name="android:shadowRadius">@integer/cover_text_shadow_radius</item>
    </style>



    <!-- View width styling -->
    <style name="LoginContentWidth">
        <item name="android:layout_width">match_parent</item>
    </style>

    <!-- Workout notification. Text uses the notification text appearances so it follows the system
         notification theme (light/dark) on every Android version. -->
    <!-- The workout notification's values: a label over a pill, between its - and +. The panels
         share the row, and the pill takes what the buttons leave. -->
    <style name="WorkoutNotificationPanel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">bottom</item>
        <item name="android:orientation">horizontal</item>
    </style>
    <!-- The label in the pill's column, so it's centred over it -->
    <style name="WorkoutNotificationValueColumn">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:orientation">vertical</item>
    </style>
    <!-- 40dp wide, rather than 48dp, so the row still fits narrow phones -->
    <style name="WorkoutNotificationButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:paddingStart">@dimen/activity_margin_half</item>
        <item name="android:paddingEnd">@dimen/activity_margin_half</item>
        <item name="android:scaleType">center</item>
        <item name="android:tint">@color/main_accent</item>
    </style>
    <!-- Grey, like the workout table's column headings -->
    <style name="WorkoutNotificationLabel" parent="TextAppearance.Compat.Notification.Info">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/gray_1</item>
        <item name="android:textSize">11sp</item>
        <item name="android:maxLines">1</item>
    </style>
    <!-- 32dp tall in the buttons' 44dp -->
    <style name="WorkoutNotificationValue" parent="TextAppearance.Compat.Notification.Title">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:paddingStart">@dimen/activity_margin_half</item>
        <item name="android:paddingEnd">@dimen/activity_margin_half</item>
        <item name="android:background">@drawable/bg_notification_value</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <!-- The collapsed notification's main button, in the style of the system's notification actions -->
    <style name="WorkoutNotificationAction" parent="TextAppearance.Compat.Notification.Title">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">@dimen/margin_12</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:textColor">@color/main_accent</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ButtonOption">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingBottom">1dp</item>
        <item name="android:textColor">@color/white_darker</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="SettingsCategory.Large">
        <item name="android:textSize">18sp</item>
    </style>
    <style name="SettingsTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/white_darker</item>
        <item name="android:textSize">@dimen/settings_row_text_size</item>
    </style>
    <style name="SettingsSubtitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/gray_1</item>
        <item name="android:textSize">@dimen/settings_row_subtitle_text_size</item>
        <item name="android:layout_marginTop">@dimen/activity_margin_half_half</item>
    </style>
    <style name="SettingsValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/main_accent</item>
        <item name="android:textSize">@dimen/settings_row_text_size</item>
        <item name="android:layout_marginRight">@dimen/activity_margin_half_half_half</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="SettingsIcon">
        <item name="android:layout_width">@dimen/settings_item_icon_size</item>
        <item name="android:layout_height">@dimen/settings_item_icon_size</item>
        <item name="android:layout_marginRight">@dimen/settings_arrow_icon_margin_left</item>
        <item name="android:tint">@color/main_accent</item>
    </style>

    <!-- BottomSheet theme. -->

</resources>
