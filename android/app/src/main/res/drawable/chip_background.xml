<?xml version="1.0" encoding="utf-8"?>
<!-- The design system's AppChip: a pill with a hairline border, tinted in the accent when selected. Change both together -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/separator">

    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/main_accent_faded_1" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/main_accent" />
                    <corners android:radius="@dimen/chip_radius" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/background_card" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/separator" />
                    <corners android:radius="@dimen/chip_radius" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
