<?xml version="1.0" encoding="utf-8"?>
<!-- Popup menus' card, like the design system's AppMenu: surface colour, 1dp separator outline.
     In from the end so by a toolbar's edge it keeps the screen's 16dp margin, as AppMenu does: XML
     toolbars' buttons reach the edge, and AppCompat ignores the style's horizontal offset here. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:end="16dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/background_card" />
            <stroke
                android:width="1dp"
                android:color="@color/separator" />
            <corners android:radius="@dimen/card_radius_large" />
            <padding
                android:bottom="8dp"
                android:top="8dp" />
        </shape>
    </item>
</layer-list>
