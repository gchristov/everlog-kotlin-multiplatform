<?xml version="1.0" encoding="utf-8"?>
<!-- A notification value's pill, like the workout table's boxed values. Grey and see-through, as the
     system picks a light or dark notification background. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#29808080" />
    <stroke android:width="1dp" android:color="#4D808080" />
    <corners android:radius="100dp" />
</shape>
