<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and up. Keep in step with backup_rules.xml. -->
<!-- Databases are caches and logs: a restored Firestore cache would be as old as the backup, so the app syncs from the server instead -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <!-- DataSync's records of what's synced, which would be wrong without the cache -->
        <exclude domain="sharedpref" path="DataSync.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <!-- DataSync's records of what's synced, which would be wrong without the cache -->
        <exclude domain="sharedpref" path="DataSync.xml" />
    </device-transfer>
</data-extraction-rules>
