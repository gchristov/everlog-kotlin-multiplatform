<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded next set view. Wrapped in DecoratedCustomViewStyle, so the system draws the app icon,
     name and background around it, and the main button as an action under it. The reps (or time)
     and the weight share the width, each a label over a pill between its - and +. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/exerciseName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_12"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:fontFamily="sans-serif-medium"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
            tools:text="Barbell bench press" />

        <TextView
            android:id="@+id/setSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Compat.Notification"
            tools:text="Super set 3/4" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_12"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/repsPanel"
            style="@style/WorkoutNotificationPanel"
            android:layout_marginEnd="@dimen/margin_12">

            <!-- Icon pinned to the start, with the icon's own 5dp inset pulled back, so the minus
                 lines up with the exercise name above -->
            <ImageView
                android:id="@+id/reduceRepsBtn"
                style="@style/WorkoutNotificationButton"
                android:layout_width="32dp"
                android:layout_marginStart="-5dp"
                android:contentDescription="@string/workout_notification_decrease_reps"
                android:paddingStart="0dp"
                android:src="@drawable/ic_remove_white" />

            <LinearLayout style="@style/WorkoutNotificationValueColumn">

                <TextView
                    style="@style/WorkoutNotificationLabel"
                    android:text="@string/workout_log_column_reps" />

                <TextView
                    android:id="@+id/repsField"
                    style="@style/WorkoutNotificationValue"
                    tools:text="10" />
            </LinearLayout>

            <ImageView
                android:id="@+id/increaseRepsBtn"
                style="@style/WorkoutNotificationButton"
                android:contentDescription="@string/workout_notification_increase_reps"
                android:src="@drawable/ic_add" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/timePanel"
            style="@style/WorkoutNotificationPanel"
            android:layout_marginEnd="@dimen/margin_12"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/reduceTimeBtn"
                style="@style/WorkoutNotificationButton"
                android:layout_width="32dp"
                android:layout_marginStart="-5dp"
                android:contentDescription="@string/workout_notification_decrease_time"
                android:paddingStart="0dp"
                android:src="@drawable/ic_remove_white" />

            <LinearLayout style="@style/WorkoutNotificationValueColumn">

                <TextView
                    style="@style/WorkoutNotificationLabel"
                    android:text="@string/workout_log_column_time" />

                <TextView
                    android:id="@+id/timeField"
                    style="@style/WorkoutNotificationValue"
                    tools:text="00:40" />
            </LinearLayout>

            <ImageView
                android:id="@+id/increaseTimeBtn"
                style="@style/WorkoutNotificationButton"
                android:contentDescription="@string/workout_notification_increase_time"
                android:src="@drawable/ic_add" />
        </LinearLayout>

        <LinearLayout style="@style/WorkoutNotificationPanel">

            <ImageView
                android:id="@+id/reduceWeightBtn"
                style="@style/WorkoutNotificationButton"
                android:contentDescription="@string/workout_notification_decrease_weight"
                android:src="@drawable/ic_remove_white" />

            <LinearLayout style="@style/WorkoutNotificationValueColumn">

                <TextView
                    android:id="@+id/weightUnit"
                    style="@style/WorkoutNotificationLabel"
                    tools:text="KG" />

                <TextView
                    android:id="@+id/weightField"
                    style="@style/WorkoutNotificationValue"
                    tools:text="60" />
            </LinearLayout>

            <!-- Icon pinned to the end, with the icon's own 5dp inset pulled back, so the plus
                 lines up with the set summary above -->
            <ImageView
                android:id="@+id/increaseWeightBtn"
                style="@style/WorkoutNotificationButton"
                android:layout_width="32dp"
                android:layout_marginEnd="-5dp"
                android:contentDescription="@string/workout_notification_increase_weight"
                android:paddingEnd="0dp"
                android:src="@drawable/ic_add" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
